# ============================================
# GraceGuide AI - Environment Variables
# ============================================

# OpenAI API Key (required for QA functionality)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# JWT Secret for authentication tokens
# Generate a secure random string (e.g., openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-change-in-production

# Admin password for accessing metrics dashboard
ADMIN_PASSWORD=your-secure-admin-password

# ============================================
# Optional: Mailchimp Integration
# ============================================
# MAILCHIMP_API_KEY=your-mailchimp-api-key
# MAILCHIMP_SERVER_PREFIX=us1
# MAILCHIMP_LIST_ID=your-list-id

# ============================================
# RevenueCat Configuration (for subscriptions)
# ============================================
# RevenueCat Webhook Secret for verifying webhook signatures
# Get from RevenueCat Dashboard > Project Settings > Webhooks
REVENUECAT_WEBHOOK_SECRET=your-webhook-secret

# RevenueCat Entitlement ID for premium features
REVENUECAT_ENTITLEMENT_ID=premium

# ============================================
# CORS / Frontend Configuration
# ============================================
# Vercel frontend URL (if deploying frontend to Vercel)
VERCEL_FRONTEND_URL=https://your-app.vercel.app

# Additional CORS origins (comma-separated for multiple domains)
# CORS_ORIGINS=https://app1.com,https://app2.com

# ============================================
# Frontend Environment Variables (for .env.local in graceguide-ui/)
# ============================================
# VITE_API_URL=https://your-backend-url.onrender.com
# VITE_REVENUECAT_API_KEY=your-revenuecat-public-api-key
# VITE_REVENUECAT_ENTITLEMENT_ID=premium
